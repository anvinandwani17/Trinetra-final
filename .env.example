# Copy to .env in the repository root. Everything is optional for the scaffold.
TRINETRA_APP_NAME=TRINETRA

# Required for authenticated raw scene downloads. Discovery remains public.
# Set these in your local .env or environment, never in Git or the frontend.
CDSE_USERNAME=
CDSE_PASSWORD=

# Only required when using --transport s3. Generated in CDSE S3 Keys Manager.
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=

# Optional relative path for public STAC metadata cache. No credentials needed
# for discovery. Download credentials above are used only by their chosen route.
TRINETRA_METADATA_CACHE_DIR=data/cache/s1_metadata

# Required only for physical preprocessing; ESA SNAP + Microwave Toolbox.
SNAP_GPT="C:/Program Files/esa-snap/bin/gpt.exe"
